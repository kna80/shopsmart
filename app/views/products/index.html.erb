<div class="container py-5">

  <!-- Page Heading -->
  <div class="text-center mb-5">
    <h1 class="display-5 fw-bold">Welcome to ShopSmart</h1>
    <p class="lead text-muted">
      Explore our collection of amazing products!
    </p>
  </div>

  <!-- Search and Filters -->
  <div class="card shadow-sm mb-5">
    <div class="card-body p-4">

      <%= form_with url: products_path, method: :get, local: true do |form| %>

        <div class="row g-3">

          <!-- Search -->
          <div class="col-md-12">
            <%= form.label :search, "Search Products", class: "form-label fw-bold" %>
            <%= form.text_field :search,
                value: params[:search],
                placeholder: "Search products by name...",
                class: "form-control" %>
          </div>

          <!-- Brand Filter -->
          <div class="col-md-4">
            <%= form.label :brand_id, "Filter by Brand", class: "form-label fw-bold" %>

            <%= form.select :brand_id,
                options_from_collection_for_select(
                  @brands, :id, :name, params[:brand_id]
                ),
                { include_blank: "All Brands" },
                { class: "form-select" } %>
          </div>

          <!-- Category Filter -->
          <div class="col-md-4">
            <%= form.label :category_id, "Filter by Category", class: "form-label fw-bold" %>

            <%= form.select :category_id,
                options_from_collection_for_select(
                  @categories, :id, :name, params[:category_id]
                ),
                { include_blank: "All Categories" },
                { class: "form-select" } %>
          </div>

          <!-- Sorting -->
          <div class="col-md-4">
            <%= form.label :sort, "Sort Products", class: "form-label fw-bold" %>

            <%= form.select :sort,
                options_for_select(
                  [
                    ["Name: A to Z", "name_asc"],
                    ["Name: Z to A", "name_desc"],
                    ["Price: Low to High", "price_low"],
                    ["Price: High to Low", "price_high"]
                  ],
                  params[:sort]
                ),
                {},
                { class: "form-select" } %>
          </div>

          <!-- Buttons -->
          <div class="col-12 text-center mt-4">
            <%= form.submit "Apply Filters",
                class: "btn btn-primary px-4 me-2" %>

            <%= link_to "Clear Filters",
                products_path,
                class: "btn btn-outline-secondary px-4" %>
          </div>

        </div>

      <% end %>

    </div>
  </div>

  <!-- Product Count -->
  <div class="mb-4">
    <h4>Available Products</h4>
    <p class="text-muted">
      <%= pluralize(@products.size, "product") %> found
    </p>
  </div>

  <!-- Product Grid -->
  <% if @products.any? %>

    <div class="row g-4">

      <% @products.each do |product| %>

        <div class="col-md-4">

          <div class="card h-100 shadow-sm">

            <% if product.image_url.present? %>
              <%= image_tag product.image_url,
                  class: "card-img-top p-3",
                  alt: product.name,
                  style: "height: 230px; object-fit: contain;" %>
            <% end %>

            <div class="card-body d-flex flex-column">

              <h5 class="card-title fw-bold">
                <%= product.name %>
              </h5>

              <p class="card-text text-muted">
                <%= truncate(product.description.to_s, length: 100) %>
              </p>

              <p>
                <strong>Brand:</strong>
                <%= product.brand&.name || "Unknown" %>
              </p>

              <h5 class="text-success">
                $<%= number_with_precision(product.price, precision: 2) %>
              </h5>

              <%= link_to "View Details",
                  product_path(product),
                  class: "btn btn-primary mt-auto" %>

            </div>

          </div>

        </div>

      <% end %>

    </div>

  <% else %>

    <div class="text-center py-5">
      <h3>No Products Found</h3>

      <p class="text-muted">
        Try changing your search or filters.
      </p>

      <%= link_to "View All Products",
          products_path,
          class: "btn btn-primary" %>
    </div>

  <% end %>
  <!-- Pagination -->
<% if @products.total_pages > 1 %>
  <div class="d-flex justify-content-center mt-5">
    <%= paginate @products, params: request.query_parameters.except("page") %>
  </div>
<% end %>

</div>